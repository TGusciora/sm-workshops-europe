#!/bin/sh
# size: tell whether the current changes are too big to review in one go.
#
# Compares the working tree with the merge-base of HEAD and a base ref.
# Counts tracked changes (staged or not) and untracked files, then reports
# the number of changed files, the added + deleted lines and the top-level
# folders touched. A per-folder breakdown helps decide how to split.
#
# Exit status:
#   0  within limits, or over limits in advisory mode
#   1  over limits with --enforce
#   2  usage or git error

set -eu

usage() {
	cat <<'EOF'
Usage: scripts/size [options]

  --base REF      base to compare against (default: origin/main, else main)
  --max-files N   changed files allowed before a split is advised (default 20)
  --max-lines N   added + deleted lines allowed before a split is advised (default 400)
  --enforce       the split flag: exit 1 when a limit is exceeded
  --advisory      only report; exit 0 even when a limit is exceeded (default)
  -h, --help      show this help

Environment overrides: SIZE_BASE, SIZE_MAX_FILES, SIZE_MAX_LINES.
EOF
}

die() {
	printf 'size: %s\n' "$1" >&2
	exit 2
}

is_number() {
	case $1 in
		'' | *[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

BASE=${SIZE_BASE:-}
MAX_FILES=${SIZE_MAX_FILES:-20}
MAX_LINES=${SIZE_MAX_LINES:-400}
MODE=advisory

while [ $# -gt 0 ]; do
	case $1 in
		--base)
			[ $# -ge 2 ] || die "--base needs a value"
			BASE=$2
			shift 2
			;;
		--base=*)
			BASE=${1#--base=}
			shift
			;;
		--max-files)
			[ $# -ge 2 ] || die "--max-files needs a value"
			MAX_FILES=$2
			shift 2
			;;
		--max-files=*)
			MAX_FILES=${1#--max-files=}
			shift
			;;
		--max-lines)
			[ $# -ge 2 ] || die "--max-lines needs a value"
			MAX_LINES=$2
			shift 2
			;;
		--max-lines=*)
			MAX_LINES=${1#--max-lines=}
			shift
			;;
		--enforce)
			MODE=enforce
			shift
			;;
		--advisory)
			MODE=advisory
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			usage >&2
			die "unknown option: $1"
			;;
	esac
done

is_number "$MAX_FILES" || die "--max-files must be a whole number, got '$MAX_FILES'"
is_number "$MAX_LINES" || die "--max-lines must be a whole number, got '$MAX_LINES'"

git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

if [ -z "$BASE" ]; then
	if git rev-parse --verify -q origin/main >/dev/null; then
		BASE=origin/main
	elif git rev-parse --verify -q main >/dev/null; then
		BASE=main
	else
		die "no base found; pass --base REF"
	fi
fi

MERGE_BASE=$(git merge-base "$BASE" HEAD 2>/dev/null) || die "cannot find a merge-base of '$BASE' and HEAD"

TMP=$(mktemp "${TMPDIR:-/tmp}/size.XXXXXX")
trap 'rm -f "$TMP"' EXIT INT TERM

# One row per changed file: added<TAB>deleted<TAB>path.
git diff --numstat "$MERGE_BASE" >"$TMP" || die "git diff failed"

# Untracked files count as all lines added.
git ls-files --others --exclude-standard | while IFS= read -r f; do
	if [ -f "$f" ]; then
		printf '%s\t0\t%s\n' "$(wc -l <"$f" | tr -d ' ')" "$f"
	fi
done >>"$TMP"

# Per-folder breakdown, largest first: lines<TAB>files<TAB>folder.
BREAKDOWN=$(awk -F '\t' '
	NF >= 3 {
		add = ($1 == "-") ? 0 : $1
		del = ($2 == "-") ? 0 : $2
		path = $3
		slash = index(path, "/")
		top = (slash > 0) ? substr(path, 1, slash - 1) : "."
		files[top]++
		lines[top] += add + del
	}
	END {
		for (d in files) printf "%d\t%d\t%s\n", lines[d], files[d], d
	}
' "$TMP" | sort -rn)

TOTALS=$(printf '%s\n' "$BREAKDOWN" | awk -F '\t' '
	NF >= 3 { lines += $1; files += $2; folders++ }
	END { print files + 0, lines + 0, folders + 0 }
')
set -- $TOTALS
FILES=$1
LINES=$2
FOLDERS=$3

printf 'size: base %s (merge-base %s)\n' "$BASE" "$(git rev-parse --short "$MERGE_BASE")"
printf '  changed files   : %s (limit %s)\n' "$FILES" "$MAX_FILES"
printf '  changed lines   : %s (added + deleted, limit %s)\n' "$LINES" "$MAX_LINES"
printf '  top-level folders: %s\n' "$FOLDERS"

if [ -n "$BREAKDOWN" ]; then
	printf '\n  lines  files  folder\n'
	printf '%s\n' "$BREAKDOWN" | awk -F '\t' 'NF >= 3 { printf "  %5d  %5d  %s\n", $1, $2, $3 }'
	printf '\n'
fi

OVER=""
if [ "$FILES" -gt "$MAX_FILES" ]; then
	OVER="files"
fi
if [ "$LINES" -gt "$MAX_LINES" ]; then
	OVER="${OVER:+$OVER and }lines"
fi

if [ -z "$OVER" ]; then
	printf 'verdict: within limits, the changes are small enough to review in one go\n'
	exit 0
fi

printf 'verdict: too big to review in one go (over limit on %s), split recommended\n' "$OVER"
if [ "$MODE" = enforce ]; then
	printf 'size: --enforce is set, failing\n' >&2
	exit 1
fi
exit 0
