{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(head .env*)",
      "Bash(head ./.env*)",
      "Bash(tail .env*)",
      "Bash(tail ./.env*)",
      "Bash(less .env*)",
      "Bash(less ./.env*)",
      "Bash(more .env*)",
      "Bash(more ./.env*)",
      "Bash(grep * .env*)",
      "Bash(grep * ./.env*)",
      "Bash(source .env*)",
      "Bash(. .env*)"
    ]
  },
  "enabledPlugins": {
    "skill-creator@anthropic-plugin-directory": true
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_DEPTH": "4"
  }
}
